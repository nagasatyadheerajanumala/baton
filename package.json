{
  "name": "baton",
  "version": "0.1.0",
  "description": "Coding-agent harness that hot-swaps LLM providers mid-session without losing context.",
  "type": "module",
  "bin": {
    "baton": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "baton.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagasatyadheerajanumala/baton.git"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "failover"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
